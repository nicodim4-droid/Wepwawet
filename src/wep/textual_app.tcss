Screen {
    background: #09192B;
    color: #D6E0EA;
}

Screen.light-theme {
    background: #EAF0F4;
    color: #23364A;
}

#app-shell {
    height: 100%;
    layout: vertical;
    padding: 0 1;
}

#header {
    height: 3;
    layout: horizontal;
    align: left middle;
    border-bottom: ascii #526176;
}

Screen.light-theme #header {
    border-bottom: ascii #7E8FA1;
}

#brand-symbol {
    width: 4;
    color: #54FFCA;
    text-style: bold;
}

#brand-name {
    width: 1fr;
    color: #54FFCA;
    text-style: bold;
}

#version {
    width: 16;
    color: #8294A9;
    text-align: right;
}

#language-select,
#theme-select {
    width: 18;
    margin-left: 1;
}

#workspace {
    height: 1fr;
    min-height: 10;
    layout: vertical;
}

#main-grid {
    height: 1fr;
    min-height: 8;
    layout: horizontal;
}

.panel {
    border: ascii #526176;
    background: #102238;
    padding: 0 1;
}

Screen.light-theme .panel {
    border: ascii #7E8FA1;
    background: #F6F8FA;
}

#serial-panel {
    width: 32;
    margin: 0 1 1 0;
}

#profile-panel {
    width: 1fr;
    margin: 0 1 1 0;
}

#right-column {
    width: 42;
    layout: vertical;
}

#diagnostics-panel {
    height: 1fr;
    min-height: 8;
    margin: 0 0 1 0;
}

#export-panel {
    height: 14;
    min-height: 12;
    margin: 0 0 1 0;
}

.panel-title {
    height: 1;
    color: #D9C1F2;
    text-style: bold;
}

Screen.light-theme .panel-title {
    color: #6D4F91;
}

#port-select {
    margin-top: 1;
}

#port-details {
    height: 1fr;
    min-height: 3;
    color: #8294A9;
    padding-top: 1;
}

Screen.light-theme #port-details {
    color: #596C80;
}

#scan-ports {
    width: 100%;
    margin-top: 1;
}

#run-diagnostics {
    margin-top: 1;
}

#diagnostic-progress {
    height: 1;
    margin-top: 1;
    display: none;
}

#diagnostic-summary {
    height: auto;
    max-height: 5;
    overflow-y: auto;
    margin-top: 1;
    color: #8294A9;
}

Screen.light-theme #diagnostic-summary {
    color: #596C80;
}

#diagnostic-output {
    height: 1fr;
    min-height: 3;
    margin-top: 1;
    border: ascii #526176;
    background: #09192B;
    color: #D6E0EA;
}

Screen.light-theme #diagnostic-output {
    border: ascii #7E8FA1;
    background: #FFFFFF;
    color: #23364A;
}

#profile-data {
    height: 1fr;
    padding-top: 1;
    color: #D6E0EA;
}

Screen.light-theme #profile-data {
    color: #23364A;
}

#export-panel .export-row {
    height: 3;
    layout: horizontal;
    align: left middle;
}

.export-row Input {
    width: 1fr;
}

.export-row Button {
    width: auto;
    min-width: 16;
    margin-left: 1;
}

#log-panel {
    height: 10;
    min-height: 6;
}

#event-log {
    height: 1fr;
    color: #8294A9;
}

Screen.light-theme #event-log {
    color: #596C80;
}

#status-line {
    height: 2;
    color: #54FFCA;
    text-style: bold;
}

Screen.light-theme #status-line {
    color: #087A5A;
}

Button {
    border: ascii #526176;
    background: #102238;
    color: #D6E0EA;
}

Screen.light-theme Button {
    border: ascii #7E8FA1;
    background: #EAF0F4;
    color: #23364A;
}

Button:focus {
    border: ascii #54FFCA;
}

Button.-primary {
    background: #15513F;
    color: #FFFFFF;
    text-style: bold;
}

Button.-success {
    background: #15513F;
    color: #FFFFFF;
}

Button.-warning {
    background: #554324;
    color: #FFCA70;
}

Button.-error {
    background: #552A32;
    color: #FF6B6B;
}

Button.flat-button {
    border: none;
    background: transparent;
}

Button.flat-button.-success {
    color: #54FFCA;
}

Button.flat-button.-warning {
    color: #FFCA70;
}

Input {
    border: ascii #526176;
    background: #09192B;
    color: #D6E0EA;
}

Screen.light-theme Input {
    border: ascii #7E8FA1;
    background: #FFFFFF;
    color: #23364A;
}

Select {
    border: ascii #526176;
    background: #102238;
    color: #D6E0EA;
}

Screen.light-theme Select {
    border: ascii #7E8FA1;
    background: #F6F8FA;
    color: #23364A;
}

ModalScreen {
    align: center middle;
    background: #09192B 80%;
}

#overwrite-message {
    margin-top: 1;
    margin-bottom: 1;
    color: #D6E0EA;
}

#overwrite-actions {
    height: 3;
    layout: horizontal;
    align: center middle;
}

#overwrite-actions Button {
    margin: 0 1;
}

#main-grid.compact-layout {
    layout: vertical;
    overflow-y: auto;
}

#main-grid.compact-layout #serial-panel,
#main-grid.compact-layout #profile-panel,
#main-grid.compact-layout #right-column {
    width: 100%;
}

#main-grid.compact-layout #serial-panel {
    height: 10;
}

#main-grid.compact-layout #profile-panel {
    height: 13;
}

#main-grid.compact-layout #right-column {
    height: 34;
}

#main-grid.compact-layout #diagnostics-panel {
    height: 20;
}

#main-grid.compact-layout #export-panel {
    height: 14;
}

Screen.compact-screen #version {
    display: none;
}

Screen.compact-screen #language-select,
Screen.compact-screen #theme-select {
    width: 14;
}

Screen.compact-screen #header {
    height: 4;
}
