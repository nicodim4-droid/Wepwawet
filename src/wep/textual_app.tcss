Screen {
    background: #09192B;
    color: #D6E0EA;
}

#profile-data .text-area--cursor-line {
    background: transparent;
}

Screen.light-theme {
    background: #EAF0F4;
    color: #23364A;
}

#app-shell {
    height: 100%;
    layout: vertical;
    padding: 0 1;
}

#header {
    height: 3;
    layout: horizontal;
    align: center middle;
    border-bottom: ascii #526176;
}

Screen.light-theme #header {
    border-bottom: ascii #7E8FA1;
}

#header-left,
#header-controls {
    width: 1fr;
    height: 100%;
    align: left middle;
}

#header-controls {
    layout: horizontal;
    align: right middle;
}

#header-controls Button {
    width: auto;
    min-width: 0;
    height: 3;
    padding: 0 1;
    margin: 0 0 0 1;
}

#brand-symbol {
    width: auto;
    color: #54FFCA;
    text-style: bold;
    content-align: center middle;
}

#brand-name {
    width: auto;
    color: #54FFCA;
    text-style: bold;
    text-align: center;
    content-align: center middle;
}

#workspace {
    height: 1fr;
    min-height: 10;
    layout: vertical;
}

#main-grid {
    height: 1fr;
    min-height: 8;
    layout: horizontal;
}

.panel {
    border: ascii #526176;
    background: #102238;
    padding: 0 1;
}

Screen.light-theme .panel {
    border: ascii #7E8FA1;
    background: #F6F8FA;
}

#serial-panel {
    width: 32;
    margin: 0 1 1 0;
}

#profile-panel {
    width: 1fr;
    margin: 0 1 1 0;
}

#right-column {
    width: 42;
    layout: vertical;
}

#diagnostics-panel {
    height: 1fr;
    min-height: 8;
    margin: 0 0 1 0;
}

#export-panel {
    height: 14;
    min-height: 12;
    margin: 0 0 1 0;
}

.panel-title {
    height: 1;
    color: #D9C1F2;
    text-style: bold;
}

Screen.light-theme .panel-title {
    color: #6D4F91;
}

#port-list {
    height: 1fr;
    min-height: 2;
    color: #8294A9;
    margin-top: 1;
    overflow-y: auto;
}

Screen.light-theme #port-list {
    color: #596C80;
}

#empty-ports {
    padding: 1;
}

Button.port-option {
    width: 100%;
    height: auto;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    text-style: none;
}

Button.port-option:hover {
    background: #263950;
    color: #54FFCA;
}

Button.port-option.selected-port {
    background: #15513F;
    color: #FFFFFF;
    text-style: bold;
}

Button.port-option.selected-port:hover {
    background: #24654F;
    color: #FFFFFF;
}

Screen.light-theme Button.port-option:hover {
    background: #DDE8F0;
    color: #087A5A;
}

Screen.light-theme Button.port-option.selected-port {
    background: #B7E8D5;
    color: #13533F;
}

Screen.light-theme Button.port-option.selected-port:hover {
    background: #9DD9C1;
    color: #103F32;
}

#scan-ports,
#run-diagnostics {
    width: 100%;
    height: 3;
    margin-top: 1;
}

#diagnostic-progress {
    height: 1;
    margin-top: 1;
    display: none;
}

ProgressBar Bar {
    & > .bar--bar {
        color: #888888;
        background: #3A3A3A;
    }

    & > .bar--complete {
        color: #888888;
        background: #3A3A3A;
    }

    & > .bar--indeterminate {
        color: #888888;
        background: #3A3A3A;
    }
}

#diagnostic-summary {
    height: auto;
    max-height: 5;
    overflow-y: auto;
    margin-top: 1;
    color: #8294A9;
}

Screen.light-theme #diagnostic-summary {
    color: #596C80;
}

#diagnostic-output {
    height: 1fr;
    min-height: 3;
    margin-top: 1;
    border: ascii #526176;
    background: #09192B;
    color: #D6E0EA;
}

Screen.light-theme #diagnostic-output {
    border: ascii #7E8FA1;
    background: #FFFFFF;
    color: #23364A;
}

#profile-data {
    height: 1fr;
    margin-top: 1;
    padding: 0 1;
    border: none;
    background: transparent;
    color: #D6E0EA;
}

Screen.light-theme #profile-data {
    color: #23364A;
}

#export-panel .export-button {
    width: 100%;
    height: 3;
    margin-top: 1;
    content-align: center middle;
    text-align: center;
}

#log-panel {
    height: 10;
    min-height: 6;
}

#event-log {
    height: 1fr;
    color: #8294A9;
}

Screen.light-theme #event-log {
    color: #596C80;
}

#status-line {
    height: 2;
    color: #54FFCA;
    text-style: bold;
}

Screen.light-theme #status-line {
    color: #087A5A;
}

Button {
    border: ascii #526176;
    background: #102238;
    color: #D6E0EA;
}

Screen.light-theme Button {
    border: ascii #7E8FA1;
    background: #EAF0F4;
    color: #23364A;
}

Button:focus {
    border: ascii #54FFCA;
    background-tint: transparent;
    text-style: bold;
}

Button.active-toggle {
    border: ascii #54FFCA;
    background: #15513F;
    color: #FFFFFF;
    text-style: bold;
}

Screen.light-theme Button.active-toggle {
    border: ascii #087A5A;
    background: #B7E8D5;
    color: #13533F;
}

Button.-primary {
    background: #15513F;
    color: #FFFFFF;
    text-style: bold;
}

Button.-success {
    background: #15513F;
    color: #FFFFFF;
}

Button.-warning {
    background: #554324;
    color: #FFCA70;
}

Button.-error {
    background: #552A32;
    color: #FF6B6B;
}

Button.flat-button {
    border: none;
    background: transparent;
}

Button.flat-button.-success {
    color: #54FFCA;
}

Button.flat-button.-warning {
    color: #FFCA70;
}

ModalScreen {
    align: center middle;
    background: #09192B 80%;
}

#overwrite-message {
    margin-top: 1;
    margin-bottom: 1;
    color: #D6E0EA;
}

#overwrite-actions {
    height: 3;
    layout: horizontal;
    align: center middle;
}

#overwrite-actions Button {
    margin: 0 1;
}

#main-grid.compact-layout {
    layout: vertical;
    overflow-y: auto;
}

#main-grid.compact-layout #serial-panel,
#main-grid.compact-layout #profile-panel,
#main-grid.compact-layout #right-column {
    width: 100%;
}

#main-grid.compact-layout #serial-panel {
    height: 10;
}

#main-grid.compact-layout #profile-panel {
    height: 13;
}

#main-grid.compact-layout #right-column {
    height: 34;
}

#main-grid.compact-layout #diagnostics-panel {
    height: 20;
}

#main-grid.compact-layout #export-panel {
    height: 14;
}

Screen.compact-screen #header-controls Button {
    padding: 0 1;
    margin: 0;
}

Screen.compact-screen #header {
    height: 5;
    layout: vertical;
}

Screen.compact-screen #header-left {
    width: 100%;
    height: 1;
    align: center middle;
}

Screen.compact-screen #brand-name {
    width: 100%;
    height: 1;
}

Screen.compact-screen #header-controls {
    width: 100%;
    height: 3;
    align: center middle;
}

.dialog-panel {
    width: 64;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: ascii #526176;
    background: #102238;
}

Screen.light-theme .dialog-panel {
    border: ascii #7E8FA1;
    background: #F6F8FA;
}

.dialog-title {
    color: #D9C1F2;
    text-style: bold;
    margin-bottom: 1;
}

Screen.light-theme .dialog-title {
    color: #6D4F91;
}

#about-dialog Button {
    width: 100%;
    margin-top: 1;
}
